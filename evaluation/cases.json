    {"id": "Q10", "category": "quality", "query": "something for yoga and meditation",
     "expect": {"avg_max": {"energy": 0.4}, "avg_min": {"instrumentalness": 0.6}}},
    {"id": "Q11", "category": "quality", "query": "confident hip-hop",
     "expect": {"top1_genre_in": ["hip hop"]}},
    {"id": "Q12", "category": "quality", "query": "angry music to vent",
